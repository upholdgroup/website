# Canonical origin, used for metadata, robots.txt, sitemap.xml and JSON-LD.
# On Vercel, set this in Project Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://www.upholdgroup.com.au

# --- Database -----------------------------------------------------------------
# Both required together. Without them the app falls back to a local JSON file
# at .data/uphold.json, which is fine for development and CI and refuses to
# accept writes in production. Run supabase/schema.sql once before switching.
SUPABASE_URL=
# Project Settings → API Keys → "Secret keys". Starts sb_secret_.
# NOT the publishable key: that one is for browsers and cannot read these
# tables, because row level security is on with no policies.
# Older projects call this the service_role key; SUPABASE_SERVICE_ROLE_KEY
# still works as a variable name.
SUPABASE_SECRET_KEY=

# --- Email --------------------------------------------------------------------
# Without a key, messages are written to the server log instead of sent — the
# admin shows a banner saying so. EMAIL_FROM must be a verified Resend sender.
RESEND_API_KEY=
EMAIL_FROM="Uphold Group <noreply@upholdgroup.com.au>"

# --- Admin --------------------------------------------------------------------
# The address allowed to claim the FIRST hire desk account. Only usable while
# no accounts exist; after that the admin_users table is the only list that
# matters, and access is revoked by removing the user.
ADMIN_EMAILS=

# Signs the admin session cookie. Required in production; in development a
# random one is generated per boot, so sessions end when the server restarts.
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
